---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	fetch_data(fetch_data)
	compute_baseline(compute_baseline)
	gather_today(gather_today)
	consult(consult)
	plan(plan)
	rest_plan(rest_plan)
	suggested_plan(suggested_plan)
	policy_check(policy_check)
	log(log)
	__end__([<p>__end__</p>]):::last
	__start__ --> fetch_data;
	compute_baseline --> gather_today;
	consult -. &nbsp;ask first&nbsp; .-> __end__;
	consult -. &nbsp;no conflict&nbsp; .-> plan;
	fetch_data --> compute_baseline;
	gather_today -. &nbsp;asked for a workout&nbsp; .-> consult;
	gather_today -. &nbsp;time left&nbsp; .-> plan;
	gather_today -. &nbsp;late or no time left&nbsp; .-> rest_plan;
	gather_today -. &nbsp;said no&nbsp; .-> suggested_plan;
	plan --> policy_check;
	policy_check --> log;
	rest_plan --> policy_check;
	suggested_plan --> policy_check;
	log --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	ingest(ingest)
	greet(greet)
	agent(agent)
	tools(tools)
	respond(respond)
	__end__([<p>__end__</p>]):::last
	__start__ --> ingest;
	agent -. &nbsp;__end__&nbsp; .-> respond;
	agent -.-> tools;
	greet --> respond;
	ingest -. &nbsp;anything else&nbsp; .-> agent;
	ingest -. &nbsp;greeting&nbsp; .-> greet;
	tools --> agent;
	respond --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

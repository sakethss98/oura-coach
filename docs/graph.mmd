---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	ingest(ingest)
	greet(greet)
	confirm_previous(confirm_previous)
	classify(classify)
	decline(decline)
	agent(agent)
	tools(tools)
	respond(respond)
	__end__([<p>__end__</p>]):::last
	__start__ --> ingest;
	agent -. &nbsp;__end__&nbsp; .-> respond;
	agent -.-> tools;
	classify -.-> agent;
	classify -. &nbsp;fixed reply&nbsp; .-> decline;
	confirm_previous --> respond;
	decline --> respond;
	greet --> respond;
	ingest -. &nbsp;anything else&nbsp; .-> classify;
	ingest -. &nbsp;stale yes&nbsp; .-> confirm_previous;
	ingest -. &nbsp;greeting&nbsp; .-> greet;
	tools --> agent;
	respond --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
